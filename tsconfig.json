{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"lib": [
			"ESNext"
		],
		"types": [
			"@cloudflare/workers-types/2023-07-01",
			"node"
		],
		"jsx": "react-jsx"
	},
	"include": [
		"src"
	]
}
